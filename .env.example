# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it holds secret keys.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Anthropic — for AI-generated practice questions
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from Stripe CLI or the webhook endpoint settings
NEXT_PUBLIC_STRIPE_PRICE_PLUS=price_...   # $15/mo Plus plan price ID
NEXT_PUBLIC_STRIPE_PRICE_COHORT=price_... # $29/mo Cohort plan price ID

# App
NEXT_PUBLIC_APP_URL=https://vitalsprep.com
